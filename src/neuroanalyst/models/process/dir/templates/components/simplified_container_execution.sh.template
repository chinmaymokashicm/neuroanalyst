# Validate that the image exists
if [ ! -f "$IMAGE_PATH" ]; then
    echo "ERROR: Singularity image not found at $IMAGE_PATH"
    echo "Please build the image first using:"
    echo "singularity build \"$IMAGE_PATH\" \"$PROCESS_DIR/$DEF_FILE\""
    exit 1
fi

# Set up environment variables and bind paths
declare -A BIND_PATHS

# Process environment variables from command line arguments
for ENV in "${CUSTOM_ENV_VARS[@]}"; do
    IFS='=' read -r ENV_NAME ENV_VALUE <<< "$ENV"
    if [[ -z "$ENV_VALUE" ]]; then
        echo "Warning: Invalid environment variable format: $ENV, should be KEY=VALUE"
        continue
    fi
    export "$ENV_NAME=$ENV_VALUE"
done

# Process bind paths from command line arguments
for BIND in "${CUSTOM_BIND_PATHS[@]}"; do
    IFS='=' read -r INTERNAL_PATH EXTERNAL_PATH <<< "$BIND"
    if [[ -z "$EXTERNAL_PATH" ]]; then
        echo "Warning: Invalid bind path format: $BIND, should be INTERNAL_PATH=EXTERNAL_PATH"
        continue
    fi
    # Store the binding in our associative array
    BIND_PATHS["$INTERNAL_PATH"]="$EXTERNAL_PATH"
done

# Execute the container with the generated command
echo "Running ${PROCESS_ID} container with arguments: ${MAIN_SCRIPT_ARGS[@]}"

# Echo the command that will be executed
echo "Executing: ${singularity_command}"

# Execute the dynamically generated command
${singularity_command}

exit_code=$?
echo "Container execution completed with exit code: $exit_code"
exit $exit_code
