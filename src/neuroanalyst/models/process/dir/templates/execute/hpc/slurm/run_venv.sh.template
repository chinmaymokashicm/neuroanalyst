#!/bin/bash
#SBATCH --job-name=${process_id}
#SBATCH --output=${process_id}_%j.out
#SBATCH --error=${process_id}_%j.err
#SBATCH --time=${slurm_time:-12:00:00}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=${max_workers}
#SBATCH --mem=${slurm_mem:-8G}
#SBATCH --partition=${slurm_partition:-compute}
#SBATCH --account=${slurm_account}
#SBATCH --qos=${slurm_qos}

#
# SLURM script for running ${process_id} using a Python virtual environment
#
# This script submits a job to run the NeuProcess using a Python virtual environment
# using the SLURM workload manager.
#
# Usage: sbatch run_venv.sh [--env KEY=VALUE...] [--bind PATH=EXTERNAL_PATH...] [arguments to pass to main.py]
#
# Environment Variables:
${environment_variables_comment}
#
# Bind Paths:
${bind_paths_comment}
#
# Author: ${author}
# Created: ${creation_date}

set -e  # Exit immediately if a command exits with a non-zero status

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
# Set the process directory (3 levels up from script)
PROCESS_DIR="$( cd "$SCRIPT_DIR/../../.." &> /dev/null && pwd )"

# Configuration
PROCESS_ID="${process_id}"
PROCESS_NAME="${process_name}"
VENV_PATH="${venv_path}"
MAIN_SCRIPT="${main_script}"
INSTALL_SCRIPT="${install_script}"

echo "============================================================="
echo "SLURM Job: Executing $PROCESS_ID ($PROCESS_NAME) with virtual environment"
echo "SLURM Job ID: $SLURM_JOB_ID"
echo "SLURM Nodes: $SLURM_JOB_NODELIST"
echo "Process Directory: $PROCESS_DIR"
echo "============================================================="

# Set environment variables
${environment_variables_export}

# Initialize variables for parsing
MAIN_SCRIPT_ARGS=()
CUSTOM_ENV_VARS=()
CUSTOM_BIND_PATHS=()

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --env)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --env requires a KEY=VALUE argument"
                exit 1
            fi
            CUSTOM_ENV_VARS+=("$2")
            shift 2
            ;;
        --bind)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --bind requires a PATH=EXTERNAL_PATH argument"
                exit 1
            fi
            CUSTOM_BIND_PATHS+=("$2")
            shift 2
            ;;
        *)
            MAIN_SCRIPT_ARGS+=("$1")
            shift
            ;;
    esac
done

# Process custom environment variables
for ENV in "${CUSTOM_ENV_VARS[@]}"; do
    IFS='=' read -r ENV_NAME ENV_VALUE <<< "$ENV"
    if [[ -z "$ENV_VALUE" ]]; then
        echo "Warning: Invalid environment variable format: $ENV, should be KEY=VALUE"
        continue
    fi
    export "$ENV_NAME=$ENV_VALUE"
    echo "Set environment variable: $ENV_NAME=$ENV_VALUE"
done

# Process custom bind paths
for BIND in "${CUSTOM_BIND_PATHS[@]}"; do
    IFS='=' read -r INTERNAL_PATH EXTERNAL_PATH <<< "$BIND"
    if [[ -z "$EXTERNAL_PATH" ]]; then
        echo "Warning: Invalid bind path format: $BIND, should be INTERNAL_PATH=EXTERNAL_PATH"
        continue
    fi
    
    # Create directory structure if needed
    mkdir -p "$PROCESS_DIR/$(dirname "$INTERNAL_PATH")"
    
    # Create symbolic link
    ln -sf "$EXTERNAL_PATH" "$PROCESS_DIR/$INTERNAL_PATH"
    echo "Created symbolic link: $EXTERNAL_PATH -> $PROCESS_DIR/$INTERNAL_PATH"
done

# Set up symbolic links for predefined bind paths (only if not already handled by custom bind paths)
if [[ ! -z "${symbolic_links_setup}" && "${symbolic_links_setup}" != "# No symbolic links to set up" ]]; then
    echo "Setting up predefined symbolic links..."
    # Store paths that were already bound through custom options
    declare -A ALREADY_BOUND
    for BIND in "${CUSTOM_BIND_PATHS[@]}"; do
        IFS='=' read -r INTERNAL_PATH _ <<< "$BIND"
        ALREADY_BOUND["$INTERNAL_PATH"]=1
    done
    
    # Now execute the symbolic_links_setup with a wrapper to check if path was already bound
    ${symbolic_links_setup}
fi

# Check if the virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo "ERROR: Virtual environment not found at $VENV_PATH"
    echo "Please create the virtual environment first using:"
    echo "python3 -m venv \"$VENV_PATH\" && source \"$VENV_PATH/bin/activate\" && bash \"$PROCESS_DIR/$INSTALL_SCRIPT\" && deactivate"
    exit 1
fi

# Activate the existing virtual environment
source "$VENV_PATH/bin/activate"
fi

# Run the main script with all arguments passed to this script
echo "Running script with arguments: ${MAIN_SCRIPT_ARGS[@]}"
python "$PROCESS_DIR/$MAIN_SCRIPT" "${MAIN_SCRIPT_ARGS[@]}"

exit_code=$?
if [ $exit_code -eq 0 ]; then
    echo "Script execution completed successfully"
else
    echo "Script execution failed with exit code $exit_code"
fi

# Clean up symbolic links
${symbolic_links_cleanup}

# Clean up symbolic links
${symbolic_links_cleanup}

# Deactivate the virtual environment
deactivate

exit $exit_code
