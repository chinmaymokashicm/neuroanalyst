#!/bin/bash
#
# install_requirements.sh
#
# This script installs all required dependencies for the NeuProcess execution.
# It can be run directly to set up the environment for script-based execution.
# It is also included in the Singularity definition file for container-based execution.
#
# For: ${process_id} - ${process_name}
# Version: ${version}
# Created: ${creation_date}
# Author: ${author}

set -e  # Exit immediately if a command exits with a non-zero status

echo "==============================================================="
echo "Installing requirements for ${process_id} - ${process_name}"
echo "==============================================================="

# Define a helper function to check and install Python packages
pip_check_install() {
    package=$1
    if python -c "import $package" &>/dev/null; then
        echo "Package $package is already installed"
    else
        echo "Installing $package..."
        pip install "$package"
    fi
}

# Install neuroanalyst package first (required for neuprocess_wrapper)
echo "Installing neuroanalyst package..."
pip install git+https://github.com/chinmaymokashicm/neuroanalyst.git@mda

# System packages
${system_packages_section}

# Install core dependencies if not already available
pip_check_install pydantic
pip_check_install pybids
pip_check_install nibabel
pip_check_install networkx
pip_check_install matplotlib
pip_check_install pandas
pip_check_install nilearn
pip_check_install rich

# Language-specific packages - only install what's not already available
${language_packages_section}

${other_installation_steps}

echo "Installation completed successfully!"
