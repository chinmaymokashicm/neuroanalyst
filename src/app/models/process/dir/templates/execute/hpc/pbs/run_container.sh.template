#!/bin/bash
#PBS -N ${process_id}
#PBS -o ${process_id}.out
#PBS -e ${process_id}.err
#PBS -l walltime=${pbs_time:-12:00:00}
#PBS -l select=1:ncpus=${max_workers}:mem=${pbs_mem:-8G}
#PBS -q ${pbs_queue:-workq}
#PBS -A ${pbs_account:-default}

#
# PBS script for running ${process_id} as a Singularity container
#
# This script submits a job to run the NeuProcess as a Singularity container 
# using the PBS workload manager.
#
# Usage: qsub run_container.sh [--env KEY=VALUE...] [--bind PATH=EXTERNAL_PATH...] [arguments to pass to main.py]
#
# Environment Variables:
${environment_variables_comment}
#
# Bind Paths:
${bind_paths_comment}
#
# Author: ${author}
# Created: ${creation_date}

set -e  # Exit immediately if a command exits with a non-zero status

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
# Set the process directory (3 levels up from script)
PROCESS_DIR="$( cd "$SCRIPT_DIR/../../.." &> /dev/null && pwd )"

# Configuration
PROCESS_ID="${process_id}"
PROCESS_NAME="${process_name}"
IMAGE_PATH="${image_path}"
DEF_FILE="${def_file}"
MAIN_SCRIPT="${main_script}"

echo "============================================================="
echo "PBS Job: Executing $PROCESS_ID ($PROCESS_NAME) as a container"
echo "PBS Job ID: $PBS_JOBID"
echo "PBS Nodes: $PBS_NODEFILE"
echo "Process Directory: $PROCESS_DIR"
echo "============================================================="

# Set environment variables
${environment_variables_export}

# Initialize variables for parsing
SINGULARITY_ARGS=()
MAIN_SCRIPT_ARGS=()
CUSTOM_ENV_VARS=()
CUSTOM_BIND_PATHS=()

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --env)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --env requires a KEY=VALUE argument"
                exit 1
            fi
            CUSTOM_ENV_VARS+=("$2")
            shift 2
            ;;
        --bind)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --bind requires a PATH=EXTERNAL_PATH argument"
                exit 1
            fi
            CUSTOM_BIND_PATHS+=("$2")
            shift 2
            ;;
        *)
            MAIN_SCRIPT_ARGS+=("$1")
            shift
            ;;
    esac
done

# Change to the directory where the job was submitted from
cd $PBS_O_WORKDIR

# Check if the image exists
if [ ! -f "$IMAGE_PATH" ]; then
    echo "ERROR: Singularity image not found at $IMAGE_PATH"
    echo "Please build the image first using:"
    echo "singularity build \"$IMAGE_PATH\" \"$DEF_FILE\""
    exit 1
fi

# Prepare bind options
BIND_OPTS=()

# Add predefined bind paths - split the options correctly
# Parse the bind_options into an array of --bind and path pairs
declare -a BIND_PARTS
read -r -a BIND_PARTS <<< "${bind_options}"

# Process the array in pairs
for ((i=0; i<${#BIND_PARTS[@]}; i+=2)); do
    if [[ "${BIND_PARTS[i]}" == "--bind" && -n "${BIND_PARTS[i+1]}" ]]; then
        BIND_OPTS+=("--bind" "${BIND_PARTS[i+1]}")
    fi
done

# Add custom bind paths from command line
for BIND in "${CUSTOM_BIND_PATHS[@]}"; do
    IFS='=' read -r INTERNAL_PATH EXTERNAL_PATH <<< "$BIND"
    if [[ -z "$EXTERNAL_PATH" ]]; then
        echo "Warning: Invalid bind path format: $BIND, should be INTERNAL_PATH=EXTERNAL_PATH"
        continue
    fi
    BIND_OPTS+=("--bind" "$EXTERNAL_PATH:$PROCESS_DIR/$INTERNAL_PATH")
    # Export environment variable for later use
    export "BIND_${INTERNAL_PATH//\//_}_PATH=$EXTERNAL_PATH"
done

# Create environment variables file for passing to container
ENV_FILE=$(mktemp)
trap 'rm -f "$ENV_FILE"' EXIT

# Add predefined environment variables
for VAR in ${environment_variables_export//export /}; do
    VAR_NAME=${VAR%%=*}
    VAR_VALUE=${!VAR_NAME}
    if [[ ! -z "$VAR_VALUE" ]]; then
        echo "$VAR_NAME=$VAR_VALUE" >> "$ENV_FILE"
    fi
done

# Add custom environment variables
for ENV in "${CUSTOM_ENV_VARS[@]}"; do
    IFS='=' read -r ENV_NAME ENV_VALUE <<< "$ENV"
    if [[ -z "$ENV_VALUE" ]]; then
        echo "Warning: Invalid environment variable format: $ENV, should be KEY=VALUE"
        continue
    fi
    echo "$ENV_NAME=$ENV_VALUE" >> "$ENV_FILE"
    export "$ENV_NAME=$ENV_VALUE"
done

# Run the container with all arguments passed to this script
echo "Running container with main script: $PROCESS_DIR/$MAIN_SCRIPT and arguments: ${MAIN_SCRIPT_ARGS[@]}"
singularity run \
    --pwd "$PROCESS_DIR" \
    --env-file "$ENV_FILE" \
    "${BIND_OPTS[@]}" \
    "$IMAGE_PATH" \
    python "$PROCESS_DIR/$MAIN_SCRIPT" "${MAIN_SCRIPT_ARGS[@]}"

exit_code=$?
if [ $exit_code -eq 0 ]; then
    echo "Container execution completed successfully"
else
    echo "Container execution failed with exit code $exit_code"
fi

exit $exit_code
