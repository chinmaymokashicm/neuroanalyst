#!/bin/bash
#BSUB -J ${process_id}
#BSUB -o ${process_id}_%J.out
#BSUB -e ${process_id}_%J.err
#BSUB -W ${lsf_time:-12:00}
#BSUB -n ${max_workers}
#BSUB -M ${lsf_mem:-8000}
#BSUB -q ${lsf_queue:-normal}
#BSUB -P ${lsf_project}

#
# LSF script for running ${process_id} using a Python virtual environment
#
# This script submits a job to run the NeuProcess using a Python virtual environment
# using the LSF workload manager.
#
# Usage: bsub < run_venv.sh -- [--env KEY=VALUE...] [--bind PATH=EXTERNAL_PATH...] [arguments to pass to main.py]
#
# Environment Variables:
${environment_variables_comment}
#
# Bind Paths:
${bind_paths_comment}
#
# Author: ${author}
# Created: ${creation_date}

set -e  # Exit immediately if a command exits with a non-zero status

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
# Set the process directory (3 levels up from script)
PROCESS_DIR="$( cd "$SCRIPT_DIR/../../.." &> /dev/null && pwd )"

# Configuration
PROCESS_ID="${process_id}"
PROCESS_NAME="${process_name}"
VENV_PATH="${venv_path}"
MAIN_SCRIPT="${main_script}"
INSTALL_SCRIPT="${install_script}"

echo "============================================================="
echo "LSF Job: Executing $PROCESS_ID ($PROCESS_NAME) with virtual environment"
echo "LSF Job ID: $LSB_JOBID"
echo "LSF Hosts: $LSB_HOSTS"
echo "Process Directory: $PROCESS_DIR"
echo "============================================================="

# Set environment variables
${environment_variables_export}

# Initialize variables for parsing
MAIN_SCRIPT_ARGS=()
CUSTOM_ENV_VARS=()
CUSTOM_BIND_PATHS=()

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --env)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --env requires a KEY=VALUE argument"
                exit 1
            fi
            CUSTOM_ENV_VARS+=("$2")
            shift 2
            ;;
        --bind)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --bind requires a PATH=EXTERNAL_PATH argument"
                exit 1
            fi
            CUSTOM_BIND_PATHS+=("$2")
            shift 2
            ;;
        *)
            MAIN_SCRIPT_ARGS+=("$1")
            shift
            ;;
    esac
done

# Process custom environment variables
for ENV in "${CUSTOM_ENV_VARS[@]}"; do
    IFS='=' read -r ENV_NAME ENV_VALUE <<< "$ENV"
    if [[ -z "$ENV_VALUE" ]]; then
        echo "Warning: Invalid environment variable format: $ENV, should be KEY=VALUE"
        continue
    fi
    export "$ENV_NAME=$ENV_VALUE"
    echo "Set environment variable: $ENV_NAME=$ENV_VALUE"
done

# Process custom bind paths
for BIND in "${CUSTOM_BIND_PATHS[@]}"; do
    IFS='=' read -r INTERNAL_PATH EXTERNAL_PATH <<< "$BIND"
    if [[ -z "$EXTERNAL_PATH" ]]; then
        echo "Warning: Invalid bind path format: $BIND, should be INTERNAL_PATH=EXTERNAL_PATH"
        continue
    fi
    export "BIND_${INTERNAL_PATH//\//_}_PATH=$EXTERNAL_PATH"
    echo "Set bind path: $INTERNAL_PATH -> $EXTERNAL_PATH"
done

# Set up symbolic links for bind paths
${symbolic_links_setup}

# Check if the virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo "ERROR: Virtual environment not found at $VENV_PATH"
    echo "Please create the virtual environment first using:"
    echo "python3 -m venv \"$VENV_PATH\" && source \"$VENV_PATH/bin/activate\" && bash \"$PROCESS_DIR/$INSTALL_SCRIPT\" && deactivate"
    exit 1
fi

# Activate the existing virtual environment
source "$VENV_PATH/bin/activate"

# Run the main script with all arguments passed to this script
echo "Running script with arguments: ${MAIN_SCRIPT_ARGS[@]}"
python "$PROCESS_DIR/$MAIN_SCRIPT" "${MAIN_SCRIPT_ARGS[@]}"

exit_code=$?
if [ $exit_code -eq 0 ]; then
    echo "Script execution completed successfully"
else
    echo "Script execution failed with exit code $exit_code"
fi

# Clean up symbolic links
${symbolic_links_cleanup}
${symbolic_links_cleanup}

# Deactivate the virtual environment
deactivate

exit $exit_code
