# Create environment variables file for passing to container
ENV_FILE=$(mktemp)
trap 'rm -f "$ENV_FILE"' EXIT

# Add predefined environment variables
if [[ ! -z "${environment_variables_export}" ]]; then
    for VAR in ${environment_variables_export//export /}; do
        if [[ "$VAR" == *"="* ]]; then
            VAR_NAME=${VAR%%=*}
            VAR_VALUE=${!VAR_NAME}
            if [[ ! -z "$VAR_VALUE" ]]; then
                echo "$VAR_NAME=$VAR_VALUE" >> "$ENV_FILE"
            fi
        fi
    done
fi

# Add custom environment variables
for ENV in "${CUSTOM_ENV_VARS[@]}"; do
    IFS='=' read -r ENV_NAME ENV_VALUE <<< "$ENV"
    if [[ -z "$ENV_VALUE" ]]; then
        echo "Warning: Invalid environment variable format: $ENV, should be KEY=VALUE"
        continue
    fi
    echo "$ENV_NAME=$ENV_VALUE" >> "$ENV_FILE"
    export "$ENV_NAME=$ENV_VALUE"
done

# Run the container with all arguments passed to this script
echo "Running container with main script: $PROCESS_DIR/$MAIN_SCRIPT and arguments: ${MAIN_SCRIPT_ARGS[@]}"

# Build the singularity command
SINGULARITY_CMD=("singularity" "run" "--pwd" "$PROCESS_DIR" "--env-file" "$ENV_FILE")

# Add bind options if any exist
if [ ${#BIND_OPTS[@]} -gt 0 ]; then
    SINGULARITY_CMD+=("${BIND_OPTS[@]}")
fi

SINGULARITY_CMD+=("$IMAGE_PATH" "python" "$PROCESS_DIR/$MAIN_SCRIPT")

# Add main script arguments if any exist
if [ ${#MAIN_SCRIPT_ARGS[@]} -gt 0 ]; then
    SINGULARITY_CMD+=("${MAIN_SCRIPT_ARGS[@]}")
fi

# Execute the command
"${SINGULARITY_CMD[@]}"

exit_code=$?
if [ $exit_code -eq 0 ]; then
    echo "Container execution completed successfully"
else
    echo "Container execution failed with exit code $exit_code"
fi

exit $exit_code
