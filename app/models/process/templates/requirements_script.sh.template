#!/bin/bash
# Installation script for {process_name}
# Generated by NeuroAnalyst NeuProcessDir
# Author: {author}
# Created: {created_timestamp}

set -e  # Exit on any error

echo "🔧 Installing requirements for {pipeline_name}..."

# Update package list
echo "📦 Updating package list..."
apt-get update

# Install system dependencies
echo "🏗️  Installing system dependencies..."
apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    python3-dev \
    python3-pip \
    python3-venv

# Upgrade pip
echo "⬆️  Upgrading pip..."
python3 -m pip install --upgrade pip

# Install Python packages
echo "🐍 Installing Python packages..."
python3 -m pip install {python_packages}

# Install NeuroAnalyst framework (if needed)
echo "🧠 Installing NeuroAnalyst framework..."
python3 -m pip install git+https://github.com/chinmaymokashicm/neurolib.git

# Clean up
echo "🧹 Cleaning up..."
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "✅ Installation complete!"

# Verify installation
echo "🔍 Verifying installation..."
python3 -c "import pybids; import nibabel; import numpy; import pandas; print('✅ Core packages verified')"

echo "🎉 {pipeline_name} environment ready!"
