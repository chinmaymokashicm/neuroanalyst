def setup_bids_layout(bids_root: str, validate: bool = False) -> BIDSLayout:
    """Initialize BIDS layout."""
    print(f"🔍 Initializing BIDS layout for: {{bids_root}}")
    layout = BIDSLayout(
        root=bids_root,
        validate=validate,
        derivatives=True,
        reset_database=False
    )
    print(f"✅ BIDS layout initialized - found {{len(layout.get_subjects())}} subjects")
    return layout


def get_input_files(layout: BIDSLayout, bids_filters: Dict[str, Any]) -> List[str]:
    """Get list of input files based on BIDS filters."""
    print(f"🔍 Searching for files with filters: {{bids_filters}}")
    
    files = layout.get(**bids_filters, return_type='filename')
    
    print(f"✅ Found {{len(files)}} files to process")
    return files


def process_single_file(args_tuple) -> Dict[str, Any]:
    """
    Process a single file - designed for multiprocessing.
    
    Args:
        args_tuple: Tuple containing (file_path, config_dict, pipeline_config)
    """
    file_path, config_dict, pipeline_config = args_tuple
    
    try:
        # Create decorator config
        decorator_config = NeuProcessDecoratorConfig(**config_dict)
        
        # Create decorated function
        decorated_func = neuprocess_decorator(decorator_config)({function_name})
        
        # Execute the function
        result = decorated_func(file_path)
        
        return {{
            'file_path': file_path,
            'success': True,
            'execution_time': result.execution_time if hasattr(result, 'execution_time') else 0.0,
            'result': result.__dict__ if hasattr(result, '__dict__') else str(result)
        }}
    except Exception as e:
        return {{
            'file_path': file_path,
            'success': False,
            'error_message': str(e),
            'execution_time': 0.0
        }}


def process_files_parallel(input_files: List[str], config_dict: Dict[str, Any], 
                          pipeline_config: Dict[str, Any], max_workers: int) -> List[Dict[str, Any]]:
    """Process files in parallel."""
    print(f"🚀 Starting parallel processing with {{max_workers}} workers")
    
    results = []
    
    # Prepare arguments for each file
    args_list = [(file_path, config_dict, pipeline_config) for file_path in input_files]
    
    with ProcessPoolExecutor(max_workers=max_workers) as executor:
        # Submit all tasks
        future_to_file = {{executor.submit(process_single_file, args): args[0] for args in args_list}}
        
        # Collect results
        for future in tqdm(as_completed(future_to_file), total=len(input_files), desc="Processing"):
            file_path = future_to_file[future]
            try:
                result = future.result()
                results.append(result)
                
                if result['success']:
                    print(f"✅ Processed: {{Path(result['file_path']).name}}")
                else:
                    print(f"❌ Failed: {{Path(result['file_path']).name}} - {{result['error_message']}}")
                    
            except Exception as e:
                print(f"❌ Exception processing {{Path(file_path).name}}: {{e}}")
                results.append({{
                    'file_path': file_path,
                    'success': False,
                    'error_message': str(e),
                    'execution_time': 0.0
                }})
    
    return results


def save_results(results: List[Dict[str, Any]], output_dir: Path, args) -> None:
    """Save processing results to JSON and CSV files."""
    # Save detailed results
    results_file = output_dir / "processing_results.json"
    with open(results_file, 'w') as f:
        json.dump(results, f, indent=2)
    print(f"📊 Results saved to: {{results_file}}")
    
    # Create summary DataFrame
    df = pd.DataFrame(results)
    csv_file = output_dir / "processing_results.csv"
    df.to_csv(csv_file, index=False)
    
    # Create summary
    summary = {{
        'total_files': len(results),
        'successful': len(df[df['success'] == True]),
        'failed': len(df[df['success'] == False]),
        'total_execution_time': df['execution_time'].sum(),
        'average_execution_time': df['execution_time'].mean(),
        'process_name': '{process_name}',
        'process_id': '{process_id}',
        'pipeline_id': args.pipeline_id,
        'process_exec_id': args.process_exec_id,
        'timestamp': datetime.now().isoformat()
    }}
    
    # Save summary
    summary_file = output_dir / "processing_summary.json"
    with open(summary_file, 'w') as f:
        json.dump(summary, f, indent=2)
    print(f"📋 Summary saved to: {{summary_file}}")


def main():
    """Main execution function."""
    parser = argparse.ArgumentParser(
        description="Execute {process_name} pipeline",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Examples:
  # Basic usage
  python main.py /data/bids_dataset --pipeline-name {pipeline_name} --pipeline-id PL001 --process-exec-id PE001 --bids-filters '{{"subject": ["01"]}}'
  python main.py /data/bids_dataset --pipeline-name {pipeline_name} --pipeline-id PL001 --process-exec-id PE002 --bids-filters '{{"task": ["rest"]}}' --max-workers 4
  
  # With custom output and overwrite
  python main.py /data/bids_dataset --pipeline-name {pipeline_name} --pipeline-id PL001 --process-exec-id PE003 --output-dir /custom/output --overwrite
'''
    )
    
    # Required arguments
    parser.add_argument('bids_root', type=str, help='Path to BIDS dataset root directory')
    parser.add_argument('--pipeline-name', type=str, required=True, help='Name of the processing pipeline')
    parser.add_argument('--pipeline-id', type=str, required=True, help='Unique pipeline identifier')
    parser.add_argument('--process-exec-id', type=str, required=True, help='Process execution identifier')
    
    # Optional arguments
    parser.add_argument('--bids-filters', type=str, default='{{}}', 
                       help='BIDS filters as JSON string (default: {{}})')
    parser.add_argument('--output-dir', type=str, default=None,
                       help='Output directory (default: <bids_root>/derivatives/<pipeline_name>)')
    parser.add_argument('--max-workers', type=int, default=mp.cpu_count(),
                       help=f'Maximum number of parallel workers (default: {{mp.cpu_count()}})')
    parser.add_argument('--overwrite', action='store_true',
                       help='Overwrite existing files')
    parser.add_argument('--validate-bids', action='store_true',
                       help='Validate BIDS dataset before processing')
    parser.add_argument('--no-parallel', action='store_true',
                       help='Disable parallel processing')
    parser.add_argument('--derivatives-dir', type=str, default='derivatives',
                       help='Name of derivatives directory (default: derivatives)')
    
    args = parser.parse_args()
    
    # Parse BIDS filters
    try:
        bids_filters = json.loads(args.bids_filters)
    except json.JSONDecodeError as e:
        print(f"❌ Error parsing BIDS filters: {{e}}")
        sys.exit(1)
    
    # Validate BIDS root
    bids_root = Path(args.bids_root)
    if not bids_root.exists():
        print(f"❌ BIDS root directory does not exist: {{bids_root}}")
        sys.exit(1)
    
    # Set output directory
    if args.output_dir:
        output_dir = Path(args.output_dir)
    else:
        output_dir = bids_root / "derivatives" / args.pipeline_name
    
    # Create output directory
    output_dir.mkdir(parents=True, exist_ok=True)
    
    print(f"🚀 Starting {{args.pipeline_name}} processing")
    print(f"📁 BIDS Root: {{bids_root}}")
    print(f"📁 Output Dir: {{output_dir}}")
    print(f"🔧 Pipeline ID: {{args.pipeline_id}}")
    print(f"🔧 Process Exec ID: {{args.process_exec_id}}")
    print(f"⚙️  Max Workers: {{args.max_workers}}")
    print(f"🔍 BIDS Filters: {{bids_filters}}")
    
    # Initialize BIDS layout
    layout = setup_bids_layout(str(bids_root), args.validate_bids)
    
    # Get input files
    input_files = get_input_files(layout, bids_filters)
    if not input_files:
        print("❌ No files found matching the specified filters")
        sys.exit(1)
    
    # Prepare configuration
    pipeline_config = {{
        'process_name': args.pipeline_name,
        'bids_root': str(bids_root),
        'overwrite': args.overwrite,
        'create_sidecar': True,
        'derivatives_dir': args.derivatives_dir,
        'bids_validate': args.validate_bids,
        'pipeline_id': args.pipeline_id,
        'process_exec_id': args.process_exec_id
    }}
    
    # Process configuration
    process_config = {{
        'author': '{author}',
        'version': '{version}',
        'description': '{description}',
        'process_id': '{process_id}',
        'pipeline_id': args.pipeline_id,
        'process_exec_id': args.process_exec_id
    }}
    
    # Process files
    if args.no_parallel:
        print("🔄 Processing files sequentially")
        results = []
        for file_path in tqdm(input_files, desc="Processing files"):
            result = process_single_file((file_path, process_config, pipeline_config))
            results.append(result)
    else:
        results = process_files_parallel(input_files, process_config, pipeline_config, args.max_workers)
    
    # Save results
    save_results(results, output_dir, args)
    
    # Print final summary
    successful = sum(1 for r in results if r['success'])
    failed = len(results) - successful
    
    print(f"\\n🎉 Processing complete!")
    print(f"✅ Successful: {{successful}}/{{len(results)}}")
    if failed > 0:
        print(f"❌ Failed: {{failed}}/{{len(results)}}")
    print(f"📁 Results saved to: {{output_dir}}")


if __name__ == "__main__":
    main()
