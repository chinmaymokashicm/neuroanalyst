#!/bin/bash
# Execution script for {pipeline_name} (Process ID: {process_id})
# Generated by NeuroAnalyst NeuProcessDir
# Author: {author}
# Created: {created_timestamp}

set -e  # Exit on any error

# Script configuration
PIPELINE_NAME="{pipeline_name}"
PROCESS_ID="{process_id}"
CONTAINER_NAME="${{PROCESS_ID}}.sif"
DEFAULT_MAX_WORKERS={default_max_workers}

# Help function
show_help() {{
    cat << EOF
Usage: $0 [OPTIONS] <bids_root>

Execute the {pipeline_name} pipeline using Singularity.

Arguments:
    bids_root           Path to BIDS root directory

Options:
    -h, --help          Show this help message
    -c, --container     Path to Singularity container (default: ./${{CONTAINER_NAME}})
    -o, --output        Output directory (default: <bids_root>/derivatives)
    -w, --workers       Maximum number of parallel workers (default: ${{DEFAULT_MAX_WORKERS}})
    -f, --filters       BIDS filters as JSON string
    --pipeline-name     Pipeline name (required)
    --pipeline-id       Pipeline ID (required)
    --process-exec-id   Process execution ID (required)
    --overwrite         Overwrite existing files
    --no-parallel       Disable parallel processing
    --validate-bids     Validate BIDS compliance
    --dry-run           Show commands that would be executed

Examples:
    # Basic usage
    $0 /data/bids_dataset --pipeline-name my_pipeline --pipeline-id PL001 --process-exec-id PE001

    # Custom container and filters
    $0 -c /path/to/container.sif -f '{{"subject": ["01", "02"]}}' /data/bids_dataset --pipeline-name my_pipeline --pipeline-id PL001 --process-exec-id PE001

    # HPC usage with specific resources
    $0 -w 8 --overwrite /data/bids_dataset

EOF
}}

# Default values
CONTAINER_PATH="./${{CONTAINER_NAME}}"
OUTPUT_DIR=""
MAX_WORKERS=${{DEFAULT_MAX_WORKERS}}
BIDS_FILTERS="{{}}"
PIPELINE_NAME_ARG="${{PIPELINE_NAME}}"
PIPELINE_ID_ARG=""
PROCESS_EXEC_ID_ARG=""
OVERWRITE=false
NO_PARALLEL=false
VALIDATE_BIDS=false
DRY_RUN=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--container)
            CONTAINER_PATH="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -w|--workers)
            MAX_WORKERS="$2"
            shift 2
            ;;
        -f|--filters)
            BIDS_FILTERS="$2"
            shift 2
            ;;
        -p|--pipeline-name)
            PIPELINE_NAME_ARG="$2"
            shift 2
            ;;
        --pipeline-id)
            PIPELINE_ID_ARG="$2"
            shift 2
            ;;
        --process-exec-id)
            PROCESS_EXEC_ID_ARG="$2"
            shift 2
            ;;
        --overwrite)
            OVERWRITE=true
            shift
            ;;
        --no-parallel)
            NO_PARALLEL=true
            shift
            ;;
        --validate-bids)
            VALIDATE_BIDS=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            show_help
            exit 1
            ;;
        *)
            if [[ -z "${{BIDS_ROOT}}" ]]; then
                BIDS_ROOT="$1"
            else
                echo "Unexpected argument: $1" >&2
                show_help
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate required arguments
if [[ -z "${{BIDS_ROOT}}" ]]; then
    echo "Error: BIDS root directory is required" >&2
    show_help
    exit 1
fi

# Validate paths
if [[ ! -d "${{BIDS_ROOT}}" ]]; then
    echo "Error: BIDS root directory does not exist: ${{BIDS_ROOT}}" >&2
    exit 1
fi

if [[ ! -f "${{CONTAINER_PATH}}" ]]; then
    echo "Error: Container file does not exist: ${{CONTAINER_PATH}}" >&2
    echo "Build the container first with: singularity build ${{CONTAINER_NAME}} ${{PROCESS_ID}}.def"
    exit 1
fi

# Set output directory if not specified
if [[ -z "${{OUTPUT_DIR}}" ]]; then
    OUTPUT_DIR="${{BIDS_ROOT}}/derivatives"
fi

# Create output directory
mkdir -p "${{OUTPUT_DIR}}"

# Build command arguments
CMD_ARGS=()
CMD_ARGS+=("${{BIDS_ROOT}}")
CMD_ARGS+=("--pipeline-name" "${{PIPELINE_NAME_ARG}}")
CMD_ARGS+=("--pipeline-id" "${{PIPELINE_ID_ARG}}")
CMD_ARGS+=("--process-exec-id" "${{PROCESS_EXEC_ID_ARG}}")
CMD_ARGS+=("--bids-filters" "${{BIDS_FILTERS}}")

if [[ "${{OVERWRITE}}" == "true" ]]; then
    CMD_ARGS+=("--overwrite")
fi

if [[ "${{NO_PARALLEL}}" == "true" ]]; then
    CMD_ARGS+=("--no-parallel")
else
    CMD_ARGS+=("--max-workers" "${{MAX_WORKERS}}")
fi

if [[ "${{VALIDATE_BIDS}}" == "true" ]]; then
    CMD_ARGS+=("--validate-bids")
fi

# Build Singularity command
SINGULARITY_CMD=(
    "singularity" "run"
    "--cleanenv"
    "--contain"
    "--bind" "${{BIDS_ROOT}}:/input:ro"
    "--bind" "${{OUTPUT_DIR}}:/output"
    "--workdir" "/work"
    "${{CONTAINER_PATH}}"
    "${{CMD_ARGS[@]}}"
)

# Display execution information
echo "=================================="
echo "  {pipeline_name} Pipeline Execution"
echo "=================================="
echo "BIDS Root:        ${{BIDS_ROOT}}"
echo "Container:        ${{CONTAINER_PATH}}"
echo "Output Dir:       ${{OUTPUT_DIR}}"
echo "Pipeline:         ${{PIPELINE_NAME_ARG}}"
echo "Pipeline ID:      ${{PIPELINE_ID_ARG}}"
echo "Process Exec ID:  ${{PROCESS_EXEC_ID_ARG}}"
echo "Max Workers:      ${{MAX_WORKERS}}"
echo "BIDS Filters:     ${{BIDS_FILTERS}}"
echo "Overwrite:        ${{OVERWRITE}}"
echo "Parallel:         ${{!NO_PARALLEL}}"
echo "Validate BIDS:    ${{VALIDATE_BIDS}}"
echo "=================================="

if [[ "${{DRY_RUN}}" == "true" ]]; then
    echo "DRY RUN - Command that would be executed:"
    echo "${{SINGULARITY_CMD[@]}}"
    exit 0
fi

# Execute the command
echo "🚀 Starting execution..."
echo "Command: ${{SINGULARITY_CMD[@]}}"
echo ""

"${{SINGULARITY_CMD[@]}}"

echo ""
echo "✅ Execution complete!"
echo "Results available in: ${{OUTPUT_DIR}}/${{PIPELINE_NAME_ARG}}/"
