def setup_bids_layout(bids_root: str, validate: bool = False) -> BIDSLayout:
    """Initialize BIDS layout."""
    print(f"🔍 Initializing BIDS layout for: {{bids_root}}")
    layout = BIDSLayout(
        root=bids_root,
        validate=validate,
        derivatives=True,
        reset_database=False
    )
    print(f"✅ BIDS layout initialized - found {{len(layout.get_subjects())}} subjects")
    return layout


def get_input_files(layout: BIDSLayout, bids_filters: Dict[str, Any]) -> List[str]:
    """Get list of input files based on BIDS filters."""
    print(f"🔍 Searching for files with filters: {{bids_filters}}")
    
    files = layout.get(**bids_filters, return_type='filename')
    
    print(f"✅ Found {{len(files)}} files to process")
    return files


