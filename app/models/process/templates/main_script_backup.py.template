def run_parallel_processing(
    input_files: List[str],
    decorator_config: Dict[str, Any],
    pipeline_config: Dict[str, Any],
    max_workers: Optional[int] = None
) -> List[Dict[str, Any]]:
    """Run processing in parallel."""
    
    if max_workers is None:
        max_workers = min(len(input_files), mp.cpu_count())
    
    print(f"🚀 Starting parallel processing with {{max_workers}} workers")
    
    # Prepare arguments for each file
    args_list = [
        (file_path, decorator_config, pipeline_config)
        for file_path in input_files
    ]
    
    results = []
    
    with ProcessPoolExecutor(max_workers=max_workers) as executor:
        # Submit all tasks
        future_to_file = {{
            executor.submit(process_single_file, args): args[0]
            for args in args_list
        }}
        
        # Process results as they complete
        for future in tqdm(as_completed(future_to_file), 
                          total=len(future_to_file), 
                          desc="Processing files"):
            try:
                result = future.result()
                results.append(result)
                
                if result['success']:
                    print(f"✅ Processed: {{Path(result['file_path']).name}}")
                else:
                    print(f"❌ Failed: {{Path(result['file_path']).name}} - {{result['error_message']}}")
                    
            except Exception as e:
                file_path = future_to_file[future]
                print(f"❌ Exception processing {{Path(file_path).name}}: {{e}}")
                results.append({{
                    'file_path': str(file_path),
                    'success': False,
                    'output_filepath': None,
                    'execution_time': 0.0,
                    'error_message': str(e),
                    'metadata': None
                }})
    
    return results


def save_results_summary(results: List[Dict[str, Any]], output_dir: Path) -> None:
    """Save processing results summary."""
    
    # Create results DataFrame
    df = pd.DataFrame(results)
    
    # Save detailed results
    results_file = output_dir / "processing_results.csv"
    df.to_csv(results_file, index=False)
    print(f"📊 Results saved to: {{results_file}}")
    
    # Create summary
    summary = {{
        'total_files': len(results),
        'successful': len(df[df['success'] == True]),
        'failed': len(df[df['success'] == False]),
        'total_execution_time': df['execution_time'].sum(),
        'average_execution_time': df['execution_time'].mean(),
        'process_name': '{process_name}',
        'process_id': '{process_id}',
        'pipeline_id': args.pipeline_id,
        'process_exec_id': args.process_exec_id,
        'timestamp': datetime.now().isoformat()
    }}
    
    # Save summary
    summary_file = output_dir / "processing_summary.json"
    with open(summary_file, 'w') as f:
        json.dump(summary, f, indent=2)
    print(f"📋 Summary saved to: {{summary_file}}")
    
    # Print summary
    print(f"\\n📊 Processing Summary:")
    print(f"  Total files: {{summary['total_files']}}")
    print(f"  Successful: {{summary['successful']}}")
    print(f"  Failed: {{summary['failed']}}")
    print(f"  Success rate: {{summary['successful']/summary['total_files']*100:.1f}}%")
    print(f"  Total time: {{summary['total_execution_time']:.2f}}s")
    print(f"  Average time per file: {{summary['average_execution_time']:.2f}}s")


def main():
    """Main execution function."""
    parser = argparse.ArgumentParser(
        description="{description}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
Examples:
  python main.py /data/bids_dataset --pipeline-name {pipeline_name} --pipeline-id PL001 --process-exec-id PE001 --bids-filters '{{"subject": ["01"]}}'
  python main.py /data/bids_dataset --pipeline-name {pipeline_name} --pipeline-id PL001 --process-exec-id PE002 --bids-filters '{{"task": ["rest"]}}' --max-workers 4
        """
    )
    
    # Required arguments
    parser.add_argument(
        'bids_root',
        type=str,
        help='Path to BIDS root directory'
    )
    
    parser.add_argument(
        '--pipeline-name',
        type=str,
        required=True,
        help='Name of the processing pipeline (required for output path generation)'
    )
    
    parser.add_argument(
        '--bids-filters',
        type=str,
        required=True,
        help='BIDS filters as JSON string for file selection (required)'
    )
    
    parser.add_argument(
        '--pipeline-id',
        type=str,
        required=True,
        help='Unique pipeline identifier for provenance tracking (required)'
    )
    
    parser.add_argument(
        '--process-exec-id',
        type=str,
        required=True,
        help='Unique process execution identifier for provenance tracking (required)'
    )
    
    # Optional arguments
    parser.add_argument(
        '--derivatives-dir',
        type=str,
        default=None,
        help='Custom derivatives directory name'
    )
    
    parser.add_argument(
        '--overwrite',
        action='store_true',
        help='Overwrite existing files'
    )
    
    parser.add_argument(
        '--no-parallel',
        action='store_true',
        help='Disable parallel processing'
    )
    
    parser.add_argument(
        '--max-workers',
        type=int,
        default=None,
        help='Maximum number of parallel workers'
    )
    
    parser.add_argument(
        '--validate-bids',
        action='store_true',
        help='Validate BIDS compliance'
    )
    
    args = parser.parse_args()
    
    # Validate BIDS root
    bids_root = Path(args.bids_root)
    if not bids_root.exists():
        print(f"❌ BIDS root directory does not exist: {{bids_root}}")
        sys.exit(1)
    
    # Parse BIDS filters
    try:
        bids_filters = json.loads(args.bids_filters)
    except json.JSONDecodeError as e:
        print(f"❌ Invalid BIDS filters JSON: {{e}}")
        sys.exit(1)
    
    # Setup BIDS layout
    try:
        layout = setup_bids_layout(str(bids_root), args.validate_bids)
    except Exception as e:
        print(f"❌ Failed to initialize BIDS layout: {{e}}")
        sys.exit(1)
    
    # Get input files
    try:
        input_files = get_input_files(layout, bids_filters)
        if not input_files:
            print("❌ No files found matching the specified filters")
            sys.exit(1)
    except Exception as e:
        print(f"❌ Failed to get input files: {{e}}")
        sys.exit(1)
    
    # Create decorator configuration
    decorator_config = {{
        'process_name': args.process_name,
        'bids_root': str(bids_root),
        'overwrite': args.overwrite,
        'create_sidecar': True,
        'derivatives_dir': args.derivatives_dir,
        'bids_validate': args.validate_bids
    }}
    
    # Process configuration
    process_config = {
        'author': '{author}',
        'version': '{version}',
        'description': '{description}',
        'process_id': '{process_id}',
        'pipeline_id': args.pipeline_id,
        'process_exec_id': args.process_exec_id
    }
    
    # Process files
    if args.no_parallel:
        print("🔄 Processing files sequentially")
        results = []
        for file_path in tqdm(input_files, desc="Processing files"):
            result = process_single_file((file_path, decorator_config, pipeline_config))
            results.append(result)
    else:
        results = run_parallel_processing(
            input_files, 
            decorator_config, 
            pipeline_config,
            args.max_workers
        )
    
    # Create output directory for results
    output_dir = bids_root / "derivatives" / args.pipeline_name
    output_dir.mkdir(parents=True, exist_ok=True)
    
    # Save results
    save_results_summary(results, output_dir)
    
    print("\\n🎉 Processing complete!")


if __name__ == "__main__":
    main()
